[animation]
compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]
config/name="Operation Steel Tide"
config/version="1.4.0"
config/icon="res://assets/branding/operation-steel-tide-icon.svg"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.3", "C#", "Forward Plus")
boot_splash/bg_color=Color(0.018, 0.024, 0.028, 1)
boot_splash/show_image=false

[autoload]
SquadNetworkRuntime="*res://csharp/SquadNetwork.cs"

[debug]
settings/profiler/max_timestamp_query_elements=1024

[display]
window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"

[input]
move_forward={"deadzone": 0.2, "events": [Object(InputEventKey,"physical_keycode":87), Object(InputEventKey,"physical_keycode":4194320)]}
move_backward={"deadzone": 0.2, "events": [Object(InputEventKey,"physical_keycode":83), Object(InputEventKey,"physical_keycode":4194322)]}
move_left={"deadzone": 0.2, "events": [Object(InputEventKey,"physical_keycode":65), Object(InputEventKey,"physical_keycode":4194319)]}
move_right={"deadzone": 0.2, "events": [Object(InputEventKey,"physical_keycode":68), Object(InputEventKey,"physical_keycode":4194321)]}
sprint={"deadzone": 0.2, "events": [Object(InputEventKey,"physical_keycode":4194325), Object(InputEventKey,"physical_keycode":16777237)]}
crouch={"deadzone": 0.2, "events": [Object(InputEventKey,"physical_keycode":67)]}
prone={"deadzone": 0.2, "events": [Object(InputEventKey,"physical_keycode":90)]}
jump={"deadzone": 0.2, "events": [Object(InputEventKey,"physical_keycode":32)]}
lean_left={"deadzone": 0.2, "events": [Object(InputEventKey,"physical_keycode":81), Object(InputEventMouseButton,"button_index":8)]}
lean_right={"deadzone": 0.2, "events": [Object(InputEventKey,"physical_keycode":69), Object(InputEventMouseButton,"button_index":9)]}
fire={"deadzone": 0.2, "events": [Object(InputEventMouseButton,"button_index":1)]}
aim={"deadzone": 0.2, "events": [Object(InputEventMouseButton,"button_index":2)]}
reload={"deadzone": 0.2, "events": [Object(InputEventKey,"physical_keycode":82)]}
weapon_primary={"deadzone": 0.2, "events": [Object(InputEventKey,"physical_keycode":49)]}
weapon_secondary={"deadzone": 0.2, "events": [Object(InputEventKey,"physical_keycode":50)]}
weapon_sidearm={"deadzone": 0.2, "events": [Object(InputEventKey,"physical_keycode":51)]}
weapon_melee={"deadzone": 0.2, "events": [Object(InputEventKey,"physical_keycode":52)]}
weapon_cycle={"deadzone": 0.2, "events": [Object(InputEventMouseButton,"button_index":4), Object(InputEventMouseButton,"button_index":5)]}
inventory={"deadzone": 0.2, "events": [Object(InputEventKey,"physical_keycode":4194306)]}
throw_grenade={"deadzone": 0.2, "events": [Object(InputEventKey,"physical_keycode":71)]}
weapon_grenade={"deadzone": 0.2, "events": [Object(InputEventKey,"physical_keycode":53)]}
weapon_utility={"deadzone": 0.2, "events": [Object(InputEventKey,"physical_keycode":54)]}
interact={"deadzone": 0.2, "events": [Object(InputEventKey,"physical_keycode":70)]}
toggle_fire_mode={"deadzone": 0.2, "events": [Object(InputEventKey,"physical_keycode":86)]}
toggle_flashlight={"deadzone": 0.2, "events": [Object(InputEventKey,"physical_keycode":84)]}
toggle_nvg={"deadzone": 0.2, "events": [Object(InputEventKey,"physical_keycode":78)]}
use_plate={"deadzone": 0.2, "events": [Object(InputEventKey,"physical_keycode":88)]}
medical_wheel={"deadzone": 0.2, "events": [Object(InputEventKey,"physical_keycode":66)]}
use_class_skill={"deadzone": 0.2, "events": [Object(InputEventKey,"physical_keycode":72)]}
squad_follow={"deadzone": 0.2, "events": [Object(InputEventKey,"physical_keycode":4194332)]}
squad_hold={"deadzone": 0.2, "events": [Object(InputEventKey,"physical_keycode":4194333)]}
squad_move={"deadzone": 0.2, "events": [Object(InputEventKey,"physical_keycode":4194334)]}
squad_hold_fire={"deadzone": 0.2, "events": [Object(InputEventKey,"physical_keycode":4194335)]}
squad_focus={"deadzone": 0.2, "events": [Object(InputEventKey,"physical_keycode":4194336)]}
squad_smoke={"deadzone": 0.2, "events": [Object(InputEventKey,"physical_keycode":4194337)]}

[rendering]
renderer/rendering_method="forward_plus"
renderer/rendering_method.mobile="mobile"
textures/default_filters/use_nearest_mipmap_filter=false
textures/vram_compression/import_etc2_astc=true
environment/defaults/default_clear_color=Color(0.012, 0.017, 0.022, 1)
lights_and_shadows/directional_shadow/size=4096
lights_and_shadows/directional_shadow/size.mobile=2048
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=2
lights_and_shadows/directional_shadow/soft_shadow_filter_quality.mobile=1
lights_and_shadows/positional_shadow/atlas_size=4096
lights_and_shadows/positional_shadow/atlas_size.mobile=2048
lights_and_shadows/positional_shadow/soft_shadow_filter_quality=2
lights_and_shadows/positional_shadow/soft_shadow_filter_quality.mobile=1
anti_aliasing/quality/msaa_3d=1
anti_aliasing/quality/msaa_3d.mobile=0

[audio]
driver/enable_input=false

[physics]
common/enable_pause_aware_picking=true
common/physics_interpolation=true

[dotnet]
project/assembly_name="OperationSteelTide"
